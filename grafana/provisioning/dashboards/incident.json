      "id": 6,
      "type": "bargauge",
      "title": "Quem deixa lento? P95 por cenário",
      "description": "Clique numa barra e escolha Filtrar Dashboard.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
