      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "links": [
            {
              "title": "Filtrar Dashboard pelo cenário: ${__field.labels.scenario}",
              "url": "/d/incident-resolution?var-scenario=${__field.labels.scenario}&${__url_time_range}"
            },
            {
              "title": "Limpar Filtro (Mostrar Todos)",
              "url": "/d/incident-resolution?var-scenario=$__all&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by (scenario) (rate(http_server_requests_total{route=\"/payment\",status_code=~\"5..\"}[5m])) or 0 * sum by (scenario) (rate(http_server_requests_total{route=\"/payment\"}[5m]))) / clamp_min(sum by (scenario) (rate(http_server_requests_total{route=\"/payment\"}[5m])), 1e-9)",
          "legendFormat": "{{scenario}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Volume por cenário",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "stacking": { "mode": "normal" },
            "fillOpacity": 85
          },
          "links": [
            {
              "title": "Filtrar Dashboard por ${__field.labels.scenario}",
              "url": "/d/incident-resolution?var-scenario=${__field.labels.scenario}&${__url_time_range}"
            },
            {
              "title": "Mostrar Todos os Cenários",
              "url": "/d/incident-resolution?var-scenario=$__all&${__url_time_range}"
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fast" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "io" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "db" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
